; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Borrowed Luck"
run/main_scene="res://ui/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
Loc="*res://autoload/loc.gd"
Catalog="*res://autoload/catalog.gd"
Profile="*res://autoload/profile.gd"
Audio="*res://autoload/audio.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/canvas_textures/default_texture_filter=0
